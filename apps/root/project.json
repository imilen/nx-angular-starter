{
  "name": "root",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/root/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/root",
        "browser": "apps/root/src/main.ts",
        "tsConfig": "apps/root/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/root/public"
          }
        ],
        "styles": ["apps/root/src/styles/index.css"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/root/src/environments/environment.ts",
              "with": "apps/root/src/environments/environment.development.ts"
            }
          ]
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "root:build:production"
        },
        "development": {
          "buildTarget": "root:build:development"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@analogjs/vitest-angular:test",
      "options": {
        "configFile": "vitest.config.unit.mts",
        "coverage": true
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "root:build",
        "port": 4200,
        "staticFilePath": "dist/apps/root/browser",
        "spa": true
      }
    },
    "storybook": {
      "executor": "@analogjs/storybook-angular:start-storybook",
      "options": {
        "port": 6006,
        "configDir": "apps/root/.storybook",
        "compodoc": true,
        "compodocArgs": ["-e", "json", "-d", "apps/root"],
        "experimentalZoneless": true
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@analogjs/storybook-angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/apps/root",
        "configDir": "apps/root/.storybook",
        "compodoc": true,
        "compodocArgs": ["-e", "json", "-d", "apps/root"],
        "experimentalZoneless": true
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "test-storybook": {
      "executor": "@analogjs/vitest-angular:test",
      "options": {
        "configFile": "vitest.config.storybook.mts",
        "coverage": true
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "dependsOn": ["build-storybook"],
      "options": {
        "buildTarget": "root:build-storybook",
        "staticFilePath": "dist/storybook/apps/root",
        "spa": true,
        "port": 6006
      },
      "configurations": {
        "ci": {
          "buildTarget": "root:build-storybook:ci"
        }
      }
    }
  }
}
